# FairSplit — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Gemini Live API (required for voice agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (required for live data; app uses synthetic fallback without it)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here           # browser-safe anon key (currently unused by backend)
SUPABASE_SERVICE_KEY=your_service_role_key_here  # backend only — NEVER expose to browser

# C++ binary paths (relative to repo root when running locally)
LOB_BINARY=./build/lob
HOUSING_MATCHER_BINARY=./build/housing_matcher

# Internal API URL used by the agent to call its own endpoints
# Set to the deployed Render URL in production
INTERNAL_API_URL=http://localhost:8000
